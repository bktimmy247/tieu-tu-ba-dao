{
 "cleanUrls": true,
 "headers": [
  {
   "source": "/(.*)\\.(html|js|json)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "no-cache"
    }
   ]
  },
  {
   "source": "/assets/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=604800"
    }
   ]
  }
 ]
}